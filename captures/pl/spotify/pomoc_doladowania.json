{
 "viewport": [
  1920,
  1080
 ],
 "slowmo": 3,
 "locale": "pl-PL",
 "timezone": "Europe/Warsaw",
 "crf": 20,
 "preset": "faster",
 "dpr": 1.5,
 "steps": [
  {
   "go": "https://support.spotify.com/pl/article/audiobook-listening-time-purchase/",
   "until": "domcontentloaded"
  },
  {
   "wait": 3500
  },
  {
   "nocookies": true
  },
  {
   "wait": 600
  },
  {
   "eval": "(()=>{const t=\"Dotknij swojego zdj\\u0119cia profilowego\";const els=[...document.querySelectorAll('li,p,span,div,h2,h3')].filter(e=>e.textContent.includes(t)&&e.getBoundingClientRect().height>0);els.sort((a,b)=>a.textContent.length-b.textContent.length);const e=els[0];if(e){window.scrollTo(0,window.scrollY+e.getBoundingClientRect().top-330);}})()"
  },
  {
   "wait": 1200
  },
  {
   "move": [
    1500,
    900
   ],
   "dur": 10
  },
  {
   "record": true
  },
  {
   "wait": 400
  },
  {
   "mark": "steps"
  },
  {
   "moveText": "Dotknij swojego zdjęcia profilowego",
   "exact": false,
   "dur": 1000
  },
  {
   "wait": 1500
  },
  {
   "moveText": "Czas słuchania audiobooków",
   "exact": false,
   "dur": 900
  },
  {
   "wait": 2500
  },
  {
   "mark": "end"
  }
 ]
}