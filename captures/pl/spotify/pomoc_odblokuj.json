  {
   "eval": "(()=>{const t=\"Je\\u015bli Tw\\u00f3j plan nie obejmuje\";const els=[...document.querySelectorAll('button,summary,h2,h3,h4,p,span,div,a')].filter(e=>e.textContent.includes(t)&&e.getBoundingClientRect().height>0);els.sort((a,b)=>a.textContent.length-b.textContent.length);const e=els[0];if(e){window.scrollTo(0,window.scrollY+e.getBoundingClientRect().top-260);}})()"
  },
  {
   "wait": 1200
  },
  {
   "move": [
    1500,
    900
   ],
   "dur": 10
  },
  {
   "record": true
  },
  {
