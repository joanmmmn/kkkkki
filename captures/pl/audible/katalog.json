{
 "viewport": [
  1920,
  1080
 ],
 "slowmo": 3,
 "locale": "pl-PL",
 "timezone": "Europe/Warsaw",
 "crf": 20,
 "preset": "faster",
 "dpr": 1.5,
 "steps": [
  {
   "go": "https://www.amazon.pl/b?node=213913801031",
   "until": "domcontentloaded"
  },
  {
   "wait": 3500
  },
  {
   "nocookies": true
  },
  {
   "wait": 600
  },
  {
   "eval": "(async()=>{for(let y=0;y<document.documentElement.scrollHeight;y+=700){window.scrollTo(0,y);await new Promise(r=>setTimeout(r,80))}})()"
  },
  {
   "wait": 900
  },
  {
   "eval": "(()=>{const h=[...document.querySelectorAll('h2')].find(e=>e.textContent.trim()==='Bestseller');if(h)window.scrollTo(0,h.getBoundingClientRect().top+window.scrollY-170);})()"
  },
  {
   "wait": 1200
  },
  {
   "move": [
    1500,
    900
   ],
   "dur": 10
  },
  {
   "record": true
  },
  {
   "wait": 400
  },
  {
   "mark": "top"
  },
  {
   "moveText": "Polski",
   "exact": true,
   "dur": 1200
  },
  {
   "wait": 1800
  },
  {
   "mark": "bestseller"
  },
  {
   "moveText": "Dolina spokoju",
   "exact": false,
   "dur": 1000
  },
  {
   "wait": 1500
  },
  {
   "move": [
    760,
    470
   ],
   "dur": 600
  },
  {
   "wait": 1500
  },
  {
   "mark": "end"
  }
 ]
}