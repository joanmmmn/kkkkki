{
 "viewport": [
  1920,
  1080
 ],
 "slowmo": 3,
 "locale": "pl-PL",
 "timezone": "Europe/Warsaw",
 "crf": 20,
 "preset": "faster",
 "dpr": 1.5,
 "steps": [
  {
   "go": "https://www.amazon.pl/hz/audible/mlp",
   "until": "domcontentloaded"
  },
  {
   "wait": 3500
  },
  {
   "nocookies": true
  },
  {
   "wait": 600
  },
  {
   "eval": "(async()=>{for(let y=0;y<document.documentElement.scrollHeight;y+=700){window.scrollTo(0,y);await new Promise(r=>setTimeout(r,80))}})()"
  },
  {
   "wait": 900
  },
  {
   "eval": "window.scrollTo(0,0)"
  },
  {
   "wait": 1200
  },
  {
   "move": [
    1500,
    900
   ],
   "dur": 10
  },
  {
   "record": true
  },
  {
   "wait": 400
  },
  {
   "mark": "top"
  },
  {
   "move": [
    552,
    554
   ],
   "dur": 1200
  },
  {
   "wait": 1600
  },
  {
   "mark": "scroll"
  },
  {
   "scroll": 760,
   "dur": 2200
  },
  {
   "wait": 300
  },
  {
   "mark": "cards"
  },
  {
   "move": [
    720,
    570
   ],
   "dur": 1000
  },
  {
   "wait": 1500
  },
  {
   "mark": "premium"
  },
  {
   "move": [
    1200,
    570
   ],
   "dur": 800
  },
  {
   "wait": 2000
  },
  {
   "mark": "end"
  }
 ]
}