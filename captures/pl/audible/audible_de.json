{
 "viewport": [
  1920,
  1080
 ],
 "slowmo": 3,
 "locale": "pl-PL",
 "timezone": "Europe/Warsaw",
 "crf": 20,
 "preset": "faster",
 "dpr": 1.5,
 "steps": [
  {
   "go": "https://www.audible.de/?language=pl_PL&ipRedirectOverride=true",
   "until": "domcontentloaded"
  },
  {
   "wait": 3500
  },
  {
   "nocookies": true
  },
  {
   "eval": "(()=>{const b=[...document.querySelectorAll('button,a,input[type=submit],span')].find(e=>/Kontynuuj bez akceptacji/i.test(e.textContent||e.value||''));if(b)b.click();const r=document.querySelector('#sp-cc-rejectall-link');if(r)r.click();})()"
  },
  {
   "wait": 1200
  },
  {
   "eval": "document.querySelectorAll('#sp-cc,[id^=sp-cc]').forEach(e=>e.remove())"
  },
  {
   "wait": 600
  },
  {
   "eval": "(async()=>{for(let y=0;y<document.documentElement.scrollHeight;y+=700){window.scrollTo(0,y);await new Promise(r=>setTimeout(r,80))}})()"
  },
  {
   "wait": 900
  },
  {
   "eval": "window.scrollTo(0,1040)"
  },
  {
   "wait": 1200
  },
  {
   "move": [
    1500,
    900
   ],
   "dur": 10
  },
  {
   "eval": "(()=>{const b=[...document.querySelectorAll('button,a,input[type=submit],span')].find(e=>/Kontynuuj bez akceptacji/i.test(e.textContent||e.value||''));if(b)b.click();const r=document.querySelector('#sp-cc-rejectall-link');if(r)r.click();})()"
  },
  {
   "wait": 600
  },
  {
   "eval": "document.querySelectorAll('#sp-cc,[id^=sp-cc]').forEach(e=>e.remove())"
  },
  {
   "record": true
  },
  {
   "wait": 400
  },
  {
   "mark": "top"
  },
  {
   "move": [
    252,
    340
   ],
   "dur": 1200
  },
  {
   "wait": 1200
  },
  {
   "mark": "pustyni"
  },
  {
   "move": [
    1232,
    340
   ],
   "dur": 900
  },
  {
   "wait": 1200
  },
  {
   "mark": "basn"
  },
  {
   "move": [
    1476,
    340
   ],
   "dur": 700
  },
  {
   "wait": 1600
  },
  {
   "mark": "end"
  }
 ]
}