{
 "viewport": [
  430,
  932
 ],
 "slowmo": 3,
 "locale": "pl-PL",
 "timezone": "Europe/Warsaw",
 "crf": 20,
 "preset": "faster",
 "dpr": 2,
 "steps": [
  {
   "go": "https://www.empik.com/dostosuj-zgody?ukryj-modal-cookie=1",
   "until": "commit"
  },
  {
   "wait": 2200
  },
  {
   "clickText": "Zapisz ustawienia",
   "dur": 10
  },
  {
   "wait": 700
  },
  {
   "go": "https://www.empik.com/go",
   "until": "commit"
  },
  {
   "wait": 3000
  },
  {
   "nocookies": true
  },
  {
   "wait": 300
  },
  {
   "eval": "(async()=>{for(let y=0;y<document.documentElement.scrollHeight;y+=600){window.scrollTo(0,y);await new Promise(r=>setTimeout(r,160))}window.scrollTo(0,0)})()"
  },
  {
   "wait": 1500
  },
  {
   "eval": "(()=>{const b=[...document.querySelectorAll('button,a,span,p')].find(e=>e.textContent.trim()==='Zatrzymaj animację');if(b)b.click()})()"
  },
  {
   "wait": 300
  },
  {
   "eval": "window.scrollTo(0,0)"
  },
  {
   "wait": 900
  },
  {
   "move": [
    215,
    600
   ],
   "dur": 10
  },
  {
   "record": true
  },
  {
   "wait": 400
  },
  {
   "mark": "top"
  },
  {
   "wait": 2000
  },
  {
   "mark": "scroll"
  },
  {
   "eval": "(async()=>{const h=[...document.querySelectorAll('h3')].find(e=>e.textContent.trim()==='Go Smart');const to=h.getBoundingClientRect().top+scrollY-301;const s0=scrollY,dy=to-s0,d=2200*3,t0=Date.now();const e=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;await new Promise(res=>{const st=()=>{const p=Math.min(1,(Date.now()-t0)/d);scrollTo(0,s0+dy*e(p));p<1?requestAnimationFrame(st):res()};requestAnimationFrame(st)})})()"
  },
  {
   "wait": 200
  },
  {
   "mark": "smart"
  },
  {
   "wait": 2600
  },
  {
   "mark": "btn"
  },
  {
   "eval": "(async()=>{const h=[...document.querySelectorAll('h3')].find(e=>e.textContent.trim()==='Go Smart');const to=scrollY+110;const s0=scrollY,dy=to-s0,d=800*3,t0=Date.now();const e=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;await new Promise(res=>{const st=()=>{const p=Math.min(1,(Date.now()-t0)/d);scrollTo(0,s0+dy*e(p));p<1?requestAnimationFrame(st):res()};requestAnimationFrame(st)})})()"
  },
  {
   "wait": 3200
  },
  {
   "mark": "end"
  }
 ],
 "mobile": true
}