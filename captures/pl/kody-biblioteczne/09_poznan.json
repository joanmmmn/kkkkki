{
 "viewport": [
  1920,
  1080
 ],
 "slowmo": 3,
 "locale": "pl-PL",
 "timezone": "Europe/Warsaw",
 "crf": 20,
 "preset": "faster",
 "dpr": 1.5,
 "steps": [
  {
   "go": "https://bracz.edu.pl/bazy-i-zasoby-cyfrowe/",
   "until": "domcontentloaded"
  },
  {
   "wait": 3500
  },
  {
   "nocookies": true
  },
  {
   "wait": 300
  },
  {
   "eval": "(async()=>{for(let y=0;y<document.documentElement.scrollHeight;y+=800){window.scrollTo(0,y);await new Promise(r=>setTimeout(r,120))}window.scrollTo(0,0)})()"
  },
  {
   "wait": 1200
  },
  {
   "eval": "(()=>{const t='Informacja o e-bookach';const els=[...document.querySelectorAll('h1,h2,h3,h4,strong,p,span,div')].filter(e=>e.textContent.includes(t)&&e.getBoundingClientRect().height>0);els.sort((a,b)=>a.textContent.length-b.textContent.length);const e=els[0];if(e){window.scrollTo(0,window.scrollY+e.getBoundingClientRect().top-160);}})()"
  },
  {
   "wait": 1200
  },
  {
   "move": [
    1500,
    900
   ],
   "dur": 10
  },
  {
   "record": true
  },
  {
   "wait": 300
  },
  {
   "mark": "top"
  },
  {
   "move": [
    920,
    330
   ],
   "dur": 900
  },
  {
   "wait": 1300
  },
  {
   "move": [
    950,
    435
   ],
   "dur": 900
  },
  {
   "wait": 1300
  },
  {
   "move": [
    760,
    455
   ],
   "dur": 700
  },
  {
   "wait": 1600
  },
  {
   "mark": "end"
  }
 ]
}